{
  "name": "facturascripts-api-node",
  "version": "0.1.0",
  "description": "BFF / API Gateway sobre la API REST de FacturaScripts (Node.js + Express + TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "carmen:index": "ts-node scripts/initialize-carmen.ts",
    "smoke:carmen": "node scripts/smoke-carmen.mjs",
    "migrate:fs": "ts-node scripts/migrate-fs-to-prisma.ts",
    "migrate:fs:dry": "ts-node scripts/migrate-fs-to-prisma.ts --dry-run",
    "reconcile:clientes:dry": "ts-node scripts/reconcile-clientes.ts --dry-run",
    "reconcile:clientes": "ts-node scripts/reconcile-clientes.ts",
    "reconcile:clientes:fs-master": "ts-node scripts/reconcile-clientes.ts --strategy=fs-master",
    "check:fs-duplicates": "ts-node scripts/check-fs-duplicates.ts",
    "script:list-endpoints": "ts-node scripts/list-endpoints.ts",
    "script:find-dead-endpoints": "ts-node scripts/find-dead-endpoints.ts",
    "openapi:generate": "ts-node scripts/generate-openapi-from-code.ts",
    "openapi:validate": "npx openapi-validator src/docs/openapi.json",
    "dev:chakra": "vite --config frontend-chakra/vite.config.ts",
    "build:chakra": "vite build --config frontend-chakra/vite.config.ts",
    "preview:chakra": "vite preview --config frontend-chakra/vite.config.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.4.1",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.16.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "framer-motion": "^11.18.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "recharts": "^2.15.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "vite": "^8.0.16"
  }
}
