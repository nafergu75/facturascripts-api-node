# Dependencias
node_modules/
frontend/node_modules/

# Secretos / entorno (NUNCA versionar el .env real).
# El patron .env* cubre tambien copias tipo .env.local.bak, que de otro modo
# se colarian en un commit (paso el 01-08-2026).
.env
.env*
!.env.example

# Builds / artefactos
dist/
frontend/dist/
frontend-chakra/dist/
*.tsbuildinfo

# Indice RAG de Carmen (regenerable con `npm run carmen:index`)
data/embeddings/index.json

# Almacenamiento en disco (datos de runtime: facturas subidas con datos
# personales, PDF/ZIP generados...). NUNCA versionar; en producción va a Vercel Blob.
storage/

# Logs y temporales
*.log
npm-debug.log*
.DS_Store

.vercel

