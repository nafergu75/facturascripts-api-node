// BD propia de la capa Node (usuarios, empresas/instancias FS, membresias).
// No contiene datos de negocio: clientes/facturas/etc. viven en cada FacturaScripts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  contable
  ventas
  solo_lectura
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  isActive      Boolean      @default(true)
  /// Admin GLOBAL de plataforma: puede acceder a TODAS las empresas y administrar.
  isGlobalAdmin Boolean      @default(false)
  /// La contrasena la puso un administrador (alta o restablecimiento de la de
  /// OTRO usuario): hasta que el usuario ponga una suya, authMiddleware solo le
  /// deja ver GET /auth/me y usar POST /auth/cambiar-contrasena.
  debeCambiarContrasena Boolean @default(false)
  /// Hasta cuando vale la contrasena provisional que puso un administrador
  /// (alta o restablecimiento): pasada esta fecha no deja entrar y hay que
  /// pedir otra. NULL = no caduca (la propia, o cuando el administrador solo
  /// pide que cambie la que ya tenia).
  contrasenaProvisionalHasta DateTime?
  /// Nombre y apellidos del usuario (Configuracion > Usuarios). NULL en los
  /// usuarios dados de alta antes de existir el campo: se muestra el correo.
  nombre        String?      @db.VarChar(120)
  /// Telefono de contacto del usuario (opcional). No sirve para entrar.
  telefono      String?      @db.VarChar(30)
  createdAt     DateTime     @default(now())
  memberships   Membership[]
}

/// Cada empresa = una instancia aislada de FacturaScripts.
model Company {
  id          String           @id @default(cuid())
  name        String
  /// Codigo corto / "codigo de acceso" de la empresa (opcional, unico).
  codigo      String?          @unique
  /// URL base de la API de su FacturaScripts (incluye /api/3).
  fsBaseUrl   String
  /// API Key de FacturaScripts CIFRADA (AES-256-GCM). Nunca en claro.
  fsApiKeyEnc String           @db.Text
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  memberships Membership[]
  reglas      ReglasContables?
  movements   Movement[]       @relation("movements")
  verifactuConfig VerifactuConfig?
}

/// Reglas contables configurables por empresa (ReglasContablesEmpresa serializada como JSON).
model ReglasContables {
  companyId String   @id
  data      Json
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Periodo contable (mes) por empresa/ejercicio: abierto|bloqueado|cerrado.
model Periodo {
  id            String  @id @default(cuid())
  companyId     String
  ejercicio     Int
  mes           Int
  estado        String  @default("abierto")
  fechaApertura String?
  fechaCierre   String?

  @@unique([companyId, ejercicio, mes])
}

/// Vencimiento de cobro/pago derivado de una factura.
model Vencimiento {
  id               String  @id @default(cuid())
  companyId        String
  facturaId        String
  tipo             String // cobro | pago
  numero           Int     @default(1)
  fecha            String
  importe          Decimal @db.Decimal(14, 2)
  formaPago        String  @default("")
  estado           String  @default("pendiente") // pendiente | liquidado
  fechaLiquidacion String?

  @@index([companyId, facturaId])
}

/// Cobro imputado a una factura (para estadoCobro).
model Cobro {
  id        String  @id @default(cuid())
  companyId String
  facturaId String
  importe   Decimal @db.Decimal(14, 2)
  fecha     String

  @@index([companyId, facturaId])
}

/// Log de auditoria persistente (acciones criticas y accesos).
model AuditLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  userId       String
  companyId    String?
  action       String
  resourceType String
  resourceId   String?
  meta         Json?

  @@index([companyId, action])
}

/// Modelo tributario del calendario fiscal (estilo Quipu: vigente/expirado/
/// omitido/presentado, casillas autorrellenadas o editadas a mano).
model ModeloImpuesto {
  id            String   @id @default(cuid())
  companyId     String
  codigo        String // '303', '390', '347', '349', '111', '115', '200'
  ejercicio     Int
  periodo       String // '1T'..'4T' | '0A'
  estado        String   @default("vigente") // vigente|expirado|omitido|presentado
  /// Casillas del modelo (autorrelleno o edicion manual). Json plano.
  casillas      Json?
  /// Datos de calculo completos (DatosModeloXXX) para generar el TXT.
  datos         Json?
  origen        String? // autorrelleno | manual-mixto
  actualizadoEn DateTime @updatedAt

  @@unique([companyId, codigo, ejercicio, periodo])
}

/// Historial de declaraciones de un modelo y periodo (B4 y B5 de la
/// integracion AEAT): la normal y sus complementarias o sustitutivas, con el
/// numero identificativo que pone la app (informativas), el justificante de la
/// sede y la instantanea de lo presentado. Nunca se borra una fila: lo que se
/// abandona queda 'anulada' (asi un numero no se vuelve a usar).
model DeclaracionAeat {
  id                   String    @id @default(cuid())
  companyId            String
  codigo               String    @db.VarChar(3)
  ejercicio            Int
  periodo              String    @db.VarChar(2)
  /// 1, 2, 3... dentro del modelo y periodo.
  secuencia            Int
  /// N normal, C complementaria (rectificativa en el 303 y el 200), S sustitutiva.
  tipo                 String    @db.VarChar(1)
  /// preparada | presentada | anulada
  estado               String    @default("preparada") @db.VarChar(10)
  /// Numero identificativo (modelo + ejercicio + contador): 347, 349, 180 y 190.
  numero               String?   @db.VarChar(13)
  anteriorId           String?
  /// Numero de la anterior que va en el fichero (justificante o numero identificativo).
  justificanteAnterior String?   @db.VarChar(20)
  /// Autoliquidaciones: lo ya ingresado de las presentadas ([29] del 111, [04] del 115...).
  resultadoAnterior    Decimal?  @db.Decimal(14, 2)
  /// Informativas: claves de los registros elegidos para la complementaria.
  registros            Json?
  /// Justificante que da la sede al presentar.
  justificante         String?   @db.VarChar(20)
  fechaPresentacion    String?   @db.VarChar(10)
  /// Instantanea al presentar: casillas.
  casillas             Json?
  /// Instantanea al presentar: fila de ModeloImpuesto, fichero, IBAN, tipo, resultado, registros...
  datos                Json?
  creadoPor            String?
  presentadoPor        String?
  creadoEn             DateTime  @default(now())
  presentadoEn         DateTime?

  @@unique([companyId, numero])
  @@unique([companyId, codigo, ejercicio, periodo, secuencia])
  @@index([companyId, codigo, ejercicio, periodo])
}

/// Relacion usuario <-> empresa con rol por empresa.
model Membership {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  role      Role    @default(solo_lectura)
  /// Permisos a medida en esta empresa: lista canonica de codigos de
  /// rbac.service (solo PERMISOS_PERSONALIZABLES). NULL = los del perfil (role).
  /// Con role = admin se ignora: el administrador lo puede todo.
  permisosPersonalizados Json?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

/// Cliente de la empresa (receptor de facturas de ingreso = cliente que nos paga).
model Customer {
  id              String          @id @default(cuid())
  companyId       String
  nombreFiscal    String
  nifCif          String
  direccion       String?
  pais            String          @default("ES")
  provincia       String?
  municipio       String?
  cp              String?
  email           String?
  telefono        String?
  activo          Boolean         @default(true)
  /// Moneda en la que se le suele facturar (ISO 4217). Solo la propone el
  /// formulario; el backend no la aplica si la factura no indica moneda.
  monedaPreferida String?         @db.VarChar(3)
  /// Subcuenta contable propia (430 + correlativo con la longitud de la
  /// empresa, 43000012). Se asigna al dar de alta la ficha; en el plan se da
  /// de alta con el nombre fiscal al primer apunte (services/terceros).
  subcuenta430    String?         @db.VarChar(15)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  invoices        IncomeInvoice[]

  @@unique([companyId, nifCif])
  @@unique([companyId, subcuenta430])
  @@index([companyId])
}

/// Factura de ingreso (dinero que nos deben = venta/servicio realizado).
model IncomeInvoice {
  id                  String                @id @default(cuid())
  companyId           String
  customerId          String
  serie               String
  // Un borrador no tiene numero: se le asigna al finalizarla, en orden y sin huecos.
  numero              Int?
  numeroCompleto      String?
  // BORRADOR (editable, no cuenta para impuestos), FINAL (numerada e inmutable)
  // o PROFORMA (serie P, no es factura: no cuenta para nada fiscal ni contable).
  // Por defecto FINAL para que las facturas que ya existian sigan contando.
  estadoDocumento     String                @default("FINAL")
  // Verifactu: F1 completa, F2 simplificada, R1-R5 rectificativas.
  tipoFactura         String                @default("F1")
  // Forma de pago que se imprime en la factura: TRANSFERENCIA, GIRO (recibo domiciliado) o CONTADO.
  formaPago           String                @default("TRANSFERENCIA")
  // Rectificativas: S (por sustitucion) o I (por diferencias), y el motivo.
  tipoRectificativa   String?
  motivoRectificacion String?               @db.Text
  finalizadaEn        DateTime?
  fechaEmision        String // YYYY-MM-DD
  fechaVencimiento    String // YYYY-MM-DD
  estado              String                @default("PENDING") // DRAFT, PENDING, PAID, OVERDUE; proformas: PENDIENTE, ACEPTADA, RECHAZADA
  // baseTotal, ivaTotal, retencionTotal y totalFactura: SIEMPRE en la moneda de
  // cuenta de la empresa (LegalConfig.monedaCuenta). Son las que leen la
  // contabilidad, el libro de IVA y los modelos de la AEAT.
  baseTotal           Decimal               @default(0) @db.Decimal(14, 2)
  ivaTotal            Decimal               @default(0) @db.Decimal(14, 2)
  retencionTotal      Decimal               @default(0) @db.Decimal(14, 2)
  totalFactura        Decimal               @default(0) @db.Decimal(14, 2)
  /// Moneda del documento (ISO 4217). Las facturas anteriores, EUR.
  moneda              String                @default("EUR") @db.VarChar(3)
  /// Unidades de `moneda` por 1 unidad de la moneda de cuenta (convencion del
  /// BCE: 1 EUR = 1,1490 USD). importeCuenta = importeDoc / tipoCambio.
  tipoCambio          Decimal               @default(1) @db.Decimal(18, 8)
  /// Fecha real de la observacion del tipo (AAAA-MM-DD); null si PAR.
  fechaTipoCambio     String?
  /// PAR | BCE | MANUAL | HEREDADO | PENDIENTE
  fuenteTipoCambio    String                @default("PAR") @db.VarChar(10)
  /// Fecha de la operacion (devengo) si es distinta de la de emision; fija el tipo de cambio.
  fechaOperacion      String?
  /// Totales en la moneda del documento. null = iguales a las columnas de cuenta.
  baseTotalDoc        Decimal?              @db.Decimal(14, 2)
  ivaTotalDoc         Decimal?              @db.Decimal(14, 2)
  retencionTotalDoc   Decimal?              @db.Decimal(14, 2)
  totalFacturaDoc     Decimal?              @db.Decimal(14, 2)
  /// Tipo de operacion de IVA (domain/tipo-operacion.model.ts). null = factura
  /// anterior a esta funcion (se clasifica con operacionEfectiva).
  tipoOperacion       String?               @db.VarChar(24)
  /// E1 | E3 | E4 | E6, solo con tipoOperacion EXENTA.
  causaExencion       String?               @db.VarChar(2)
  /// Precepto que ampara la exencion (obligatorio en EXENTA, opcional en ISP_NACIONAL).
  referenciaLegal     String?               @db.VarChar(200)
  /// Solo facturas sin tipo de operacion (anteriores a esta funcion y sus
  /// rectificativas): pais del cliente TAL CUAL estaba en su ficha, congelado
  /// antes de que cambie. Con el se clasifican como siempre en 303/347/349/390
  /// aunque luego se edite la ficha. null = el pais actual de la ficha.
  paisClienteLegacy   String?
  plantillaId         String                @default("default")
  observaciones       String?               @db.Text
  esRectificativa     Boolean               @default(false)
  facturaOriginalId   String? // Si es rectificativa, ref a la original
  /// Rectificativa de una factura emitida fuera de la app, antes de llevar la
  /// contabilidad en ella (p. ej. una de 2026 que trajo la gestoria): su numero y su fecha.
  rectificaFueraNumero String? @db.VarChar(60)
  rectificaFueraFecha String?  @db.VarChar(10)
  /// Causa de la rectificativa de venta (domain/rectificativa-venta.model.ts): DEVOLUCION | DESCUENTO | RAPPEL | CAMBIO_PRECIO | ERROR_DERECHO | ERROR | OTROS | CONCURSO | IMPAGO. null en facturas y en rectificativas anteriores.
  causaRectificacion  String?               @db.VarChar(16)
  // Factura que nace de una proforma aceptada ("Pasar a factura"): id de la proforma.
  // Unico: una proforma solo se convierte una vez.
  proformaId          String?               @unique
  esRecurrente        Boolean               @default(false)
  recurrenciaConfig   String? // JSON con patrón: { frecuencia: 'mensual'|'trimestral', proximaFecha: '...' }
  /// Copia, al emitir, del IBAN que sale en la factura ('' = sin IBAN). null:
  /// borrador, proforma o factura anterior a esta copia (el PDF usa los ajustes de ahora).
  ibanCobro           String?
  /// Copia, al emitir, del texto legal al pie ('' = sin texto). null: como ibanCobro.
  textoPie            String?               @db.Text
  /// De donde nace la factura: pantalla | api | copia | lector (VERI*FACTU, spec 2.8).
  /// Lo pone el servidor en todos los caminos de alta, nunca el cuerpo. null:
  /// factura anterior a esta columna (se trata como anterior a la activacion).
  origen              String?               @db.VarChar(10)
  /// Peso bruto en kg escrito a mano (plantilla A).
  pesoBrutoKg       Decimal? @db.Decimal(14, 3)
  /// Tipo del IEEPNR aplicado (EUR por kg); null = sin IEEPNR.
  ieepnrPorKg       Decimal? @db.Decimal(8, 4)
  /// Cuenta del IEEPNR congelada al emitir (la de los ajustes o la de la
  /// original); null = la de ingresos de cada linea. La usa el asiento.
  ieepnrCuenta      String?  @db.VarChar(15)
  /// Obra de la factura (plantilla B): el proyecto o la obra del cliente, opcional.
  obra              String?  @db.VarChar(200)
  /// Peso neto en kg escrito a mano (plantilla B).
  pesoNetoKg        Decimal? @db.Decimal(14, 3)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lineas              IncomeInvoiceLine[]
  customer            Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  readerDocument      IncomeReaderDocument?
  /// Que rectifica esta rectificativa: facturas de la app, de fuera o un periodo.
  enlacesRectifica      IncomeInvoiceRectificada[] @relation("RectificativaVenta")
  /// Rectificativas que rectifican esta factura.
  enlacesRectificadaPor IncomeInvoiceRectificada[] @relation("OriginalVenta")

  @@unique([companyId, serie, numero])
  // Unico DENTRO de cada empresa: antes era unico en toda la BD, y dos empresas
  // no podian tener cada una su factura 2026-1.
  @@unique([companyId, numeroCompleto])
  @@index([companyId, estado])
  @@index([companyId, estadoDocumento])
  @@index([customerId])
  @@index([companyId, moneda])
  @@index([companyId, tipoOperacion])
}

/// Que rectifica una rectificativa de venta: una o varias facturas (de la app
/// o de fuera) o un periodo (rappel). Art. 15.4 RD 1619/2012. Simetrica de
/// ExpenseInvoiceRectificada.
model IncomeInvoiceRectificada {
  id                   String         @id @default(cuid())
  companyId            String
  rectificativaId      String
  /// Original emitida o registrada en la app. null: de fuera (2026 llevada fuera) o fila de periodo.
  originalId           String?
  /// Numero y fecha de la original (obligatorios sin originalId; se copian si la hay).
  numeroOriginal       String?        @db.VarChar(60)
  fechaOriginal        String?        @db.VarChar(10)
  /// Rappel o descuento por volumen: periodo (excluye originalId y numeroOriginal).
  periodoDesde         String?        @db.VarChar(10)
  periodoHasta         String?        @db.VarChar(10)
  /// Partida de cobro de la carga de 2026 que rebaja este abono.
  partidaPendienteId   String?
  /// Parte de la rectificacion que toca a esta fila, con signo, en moneda de cuenta. null = toda (una sola fila).
  baseRectificada      Decimal?       @db.Decimal(14, 2)
  cuotaRectificada     Decimal?       @db.Decimal(14, 2)
  retencionRectificada Decimal?       @db.Decimal(14, 2)
  createdAt            DateTime       @default(now())
  rectificativa        IncomeInvoice  @relation("RectificativaVenta", fields: [rectificativaId], references: [id], onDelete: Cascade)
  original             IncomeInvoice? @relation("OriginalVenta", fields: [originalId], references: [id], onDelete: Restrict)

  @@index([companyId, originalId])
  @@index([rectificativaId])
  @@index([companyId, partidaPendienteId])
}

/// Serie de facturacion de una empresa (A, RECTIFICATIVA, ...). Guarda el
/// ultimo numero emitido para numerar sin huecos al finalizar cada factura.
model InvoiceSeries {
  id            String   @id @default(cuid())
  companyId     String
  codigo        String
  descripcion   String
  tipoDocumento String   @default("FACTURA") // FACTURA | RECTIFICATIVA | PRESUPUESTO | ALBARAN | PEDIDO
  activa        Boolean  @default(true)
  porDefecto    Boolean  @default(false)
  ultimoNumero  Int      @default(0)
  ultimaFecha   String? // YYYY-MM-DD de la ultima factura finalizada
  /// Plantilla del PDF de la serie (default, A, B, C); null = automatica.
  plantilla         String?  @db.VarChar(16)
  /// Observaciones por defecto de la serie: se proponen en cada factura nueva (editables).
  observacionesDefecto String? @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, codigo])
}

/// Línea de factura de ingreso.
model IncomeInvoiceLine {
  id                  String        @id @default(cuid())
  invoiceId           String
  productoServicioId  String?
  descripcion         String
  cantidad            Float
  precioUnitario      Decimal       @db.Decimal(14, 4)
  baseLine            Decimal       @db.Decimal(14, 2) // cantidad * precioUnitario - descuentoImporte
  descuentoPorcentaje Float         @default(0)
  descuentoImporte    Decimal       @default(0) @db.Decimal(14, 2)
  tipoIva             Int           @default(21) // 0, 4, 10, 21
  ivaImporte          Decimal       @default(0) @db.Decimal(14, 2)
  tipoRetencion       Int           @default(0) // 0, 7, 15, 19 (IRPF/otros)
  retencionImporte    Decimal       @default(0) @db.Decimal(14, 2)
  // Las columnas de arriba van en la moneda de cuenta (precioUnitario y
  // descuentoImporte son informativos si la factura esta en otra moneda).
  // Las *Doc, en la moneda del documento; null = iguales a las de cuenta.
  precioUnitarioDoc   Decimal?      @db.Decimal(14, 4)
  baseLineDoc         Decimal?      @db.Decimal(14, 2)
  descuentoImporteDoc Decimal?      @db.Decimal(14, 2)
  ivaImporteDoc       Decimal?      @db.Decimal(14, 2)
  retencionImporteDoc Decimal?      @db.Decimal(14, 2)
  // NUEVO: Referencia a cuenta contable (grupo 7 para ingresos)
  accountCode         String? // Código PGC (ej. "700" para ventas)
  /// Packs de la linea (plantilla A). cantidad = unidades.
  packs             Int?
  /// Kg de plastico no reciclado de la linea (hasta 3 decimales).
  kgPlastico        Decimal? @db.Decimal(14, 3)
  /// IEEPNR repercutido de la linea, en EUR. Va DENTRO de baseLine (base del IVA).
  ieepnrImporte     Decimal? @db.Decimal(14, 2)
  /// Texto adicional bajo el concepto (el del articulo, editable).
  textoAdicional    String?  @db.Text
  /// Palets de la linea (plantilla B).
  palets            Int?
  /// Cajas de la linea (plantilla B).
  cajas             Int?
  /// Metros cuadrados de la linea (plantilla B), hasta 3 decimales.
  metros2           Decimal? @db.Decimal(14, 3)
  /// Piezas (o unidades) de la linea (plantilla B).
  piezas            Decimal? @db.Decimal(14, 3)
  /// Formato de la pieza (plantilla B): 23,3x120.
  formato           String?  @db.VarChar(40)
  /// Calidad (plantilla B): 1, 2...
  calidad           String?  @db.VarChar(10)
  /// Peso de la linea en kg (plantilla B).
  pesoKg            Decimal? @db.Decimal(14, 3)
  /// Unidad del precio (plantilla B): M2 | PIEZA | UNIDAD. cantidad = m2, piezas o unidades.
  unidadPrecio      String?  @db.VarChar(10)
  /// Cargo de palets de madera (plantilla B): va en el pie del PDF, no en la tabla.
  cargoPalets       Boolean  @default(false)
  invoice             IncomeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([accountCode])
}

/// Documento de ingreso procesado por OCR (ticket/factura subido para digitalizar).
/// Tabla del lector CANÓNICO (income-reader). El lector legacy (lectorFacturas)
/// no tiene tabla propia: persiste en memoria. No hay modelos duplicados que
/// deprecar. Ver ADR "Consolidación de lector OCR".
model IncomeReaderDocument {
  id                    String         @id @default(cuid())
  companyId             String
  userId                String? // Usuario que subió el documento
  sourceType            String // MOBILE_CAMERA, WEB_UPLOAD, EMAIL_FORWARD
  originalFileName      String
  mimeType              String
  fileSize              Int
  storagePath           String // Path local o URL a S3/blob
  status                String         @default("UPLOADED") // UPLOADED | PROCESSING | READY_FOR_VERIFICATION | VERIFIED | REJECTED | ERROR
  errorMensaje          String? // Último error de OCR (si status=ERROR)
  uploadedAt            DateTime       @default(now())
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  verifiedAt            DateTime?
  expiresAt             DateTime? // Fecha límite de validez del documento (opcional; si ya pasó, está expirado)
  parsedData            Json? // { cliente, fecha, numero, base, iva, retencion, lineas: [...] }
  linkedInvoiceId       String?        @unique // FK a IncomeInvoice creada tras verificación
  invoice               IncomeInvoice? @relation(fields: [linkedInvoiceId], references: [id], onDelete: SetNull)
  rejectionReason       String?

  @@index([companyId, status])
  @@index([companyId, uploadedAt])
  @@index([companyId, expiresAt])
}

/// Configuración de email del lector automático (correo donde reenviarse facturas).
model ReaderEmailConfig {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  readerEmail         String // empresa+lector@platform.com
  isReaderEmailActive Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
}

/// Versión del Plan General de Contabilidad (PGC). Controla cambios en la estructura base.
model ChartOfAccountsVersion {
  id                 String            @id @default(cuid())
  version            String            @unique // "2021", "2016", "2007"
  descripcion        String
  fechaActualizacion DateTime          @default(now())
  isActive           Boolean           @default(true)
  cuentas            ChartOfAccounts[]

  @@index([version])
}

/// Cuenta contable del Plan General de Contabilidad (PGC).
model ChartOfAccounts {
  id                     String   @id @default(cuid())
  companyId              String? // null = cuenta base PGC global; no-null = personalización de empresa
  codigo                 String // "700", "4300001", "572000", etc.
  nombre                 String
  grupo                  Int // 1-9
  nivel                  Int // 1=grupo, 2=subgrupo, 3=cuenta, 4+=subcuenta
  naturaleza             String // ACTIVO, PASIVO, PATRIMONIO_NETO, GASTO, INGRESO
  tipoUso                String // BALANCE, PYG, AMBOS
  esBasePGC              Boolean  @default(true) // Pertenece al PGC oficial
  esPersonalizadaEmpresa Boolean  @default(false) // Subcuenta propia de empresa
  activo                 Boolean  @default(true)
  ordenPresentacion      Int?
  parentId               String? // FK a cuenta padre (para jerarquía)
  parentCodigo           String? // Código de la cuenta padre (para facilitar búsquedas)
  versionPGC             String? // "2021", "2016", etc.
  notas                  String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  parent     ChartOfAccounts?        @relation("Jerarquia", fields: [parentId], references: [id], onDelete: SetNull)
  children   ChartOfAccounts[]       @relation("Jerarquia")
  pgcVersion ChartOfAccountsVersion? @relation(fields: [versionPGC], references: [version])

  @@unique([companyId, codigo])
  @@index([companyId])
  @@index([grupo])
  @@index([naturaleza])
  @@index([activo])
}

/// Cierre de ejercicio contable (cierre de año fiscal).
model AccountingClosure {
  id               String                  @id @default(cuid())
  companyId        String
  ejercicio        Int // Año fiscal (2024, 2025, etc.)
  estado           String                  @default("ABIERTO") // ABIERTO, EN_CIERRE, CERRADO, REABIERTO
  fechaApertura    DateTime                @default(now())
  fechaCierre      DateTime?
  cierreContable   String? // JSON con datos del cierre (base, IVA, etc.)
  balanceGeneral   String?                 @db.Text // JSON con balance general
  cuentaResultados String?                 @db.Text // JSON con P&L
  observaciones    String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  archivos         AccountingClosureFile[]

  @@unique([companyId, ejercicio])
  @@index([companyId])
  @@index([ejercicio])
  @@index([estado])
}

/// Archivo de cierre contable (PDF, Excel, etc.).
model AccountingClosureFile {
  id            String            @id @default(cuid())
  closureId     String
  companyId     String
  nombre        String
  tipoArchivo   String // "PDF", "EXCEL", "TXT"
  mimeType      String
  fileSize      Int
  storagePath   String // Path o URL a almacenamiento
  ejercicio     Int
  tipoContenido String // "BALANCE_GENERAL", "CUENTA_RESULTADOS", "LIBROS_DIARIOS", "LIBRO_MAYOR"
  uploadedBy    String? // UserId de quién subió
  uploadedAt    DateTime          @default(now())
  closure       AccountingClosure @relation(fields: [closureId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([ejercicio])
  @@index([tipoContenido])
}

/// Datos de ejercicios anteriores (para comparativas, auditoría, etc.).
model PriorYearData {
  id             String   @id @default(cuid())
  companyId      String
  ejercicio      Int
  estado         String // "BORRADOR", "CONFIRMADO", "AUDITADO"
  baseImponible  Decimal  @default(0) @db.Decimal(14, 2)
  ivaDevengado   Decimal  @default(0) @db.Decimal(14, 2)
  ivaRepercutido Decimal  @default(0) @db.Decimal(14, 2)
  irpfRetenido   Decimal  @default(0) @db.Decimal(14, 2)
  gasto          Decimal  @default(0) @db.Decimal(14, 2)
  ingresos       Decimal  @default(0) @db.Decimal(14, 2)
  beneficio      Decimal  @default(0) @db.Decimal(14, 2)
  datosJSON      String?  @db.Text // Estructura completa de datos contables
  observaciones  String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, ejercicio])
  @@index([companyId])
  @@index([ejercicio])
}

/// ============================================================================
/// MOTOR CONTABLE AUTOMÁTICO (PGC Español)
/// ============================================================================

/// Asiento contable (entrada en el libro mayor)
model JournalEntry {
  id            String             @id @default(cuid())
  companyId     String
  fecha         DateTime
  numeroAsiento String // FAC-ING-xxx, FAC-GAST-xxx, AJUSTE-xxx
  descripcion   String
  origen        String // FACTURA_INGRESO, FACTURA_GASTO, TESORERIA, AJUSTE_MANUAL
  estado        String             @default("DRAFT") // DRAFT, PENDING_REVIEW, POSTED, REVERSED
  invoiceId     String? // Referencia a factura de ingreso
  invoiceType   String? // INGRESO, GASTO
  lineas        JournalEntryLine[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([companyId, numeroAsiento])
  @@index([companyId])
  @@index([fecha])
  @@index([origen])
}

/// Línea de asiento contable (debe/haber)
model JournalEntryLine {
  id          String   @id @default(cuid())
  entryId     String
  accountCode String // Código PGC (700, 430, 477, etc.)
  accountName String
  debe        Decimal  @default(0) @db.Decimal(14, 2)
  haber       Decimal  @default(0) @db.Decimal(14, 2)
  referencia  String? // Número de factura, movimiento, etc.
  companyId   String
  createdAt   DateTime @default(now())

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([accountCode])
  @@index([companyId])
}

/// Libro de IVA (facturas emitidas y recibidas)
model VATBook {
  id            String   @id @default(cuid())
  companyId     String
  tipoLibro     String // EMITIDAS, RECIBIDAS
  numeroFactura String
  fechaFactura  DateTime
  nifTercero    String // NIF del cliente/proveedor
  nombreTercero String
  baseImponible Decimal  @db.Decimal(14, 2)
  tipoIva       Int // 0, 4, 10, 21
  cuotaIva      Decimal  @db.Decimal(14, 2)
  asientoId     String? // Referencia al asiento contable
  observaciones String?  @db.Text
  /// Tipo de operacion de la factura (domain/tipo-operacion.model.ts); null = anterior.
  tipoOperacion String?  @db.VarChar(24)
  /// E1..E6 (E2 exportacion y E5 intracomunitaria se derivan del tipo).
  causaExencion String?  @db.VarChar(2)
  /// Solo RECIBIDAS: numero de la factura del proveedor. null = anterior (el numero es numeroFactura).
  numeroFacturaEmisor String? @db.VarChar(60)
  createdAt     DateTime @default(now())

  // Un apunte por tipo de IVA: una factura 21% + 10% son dos filas.
  @@unique([companyId, tipoLibro, numeroFactura, tipoIva])
  @@index([companyId])
  @@index([fechaFactura])
  @@index([tipoLibro])
  @@index([companyId, tipoLibro, tipoOperacion])
}

/// ============================================================================
/// ASISTENTE "CARMEN" (datos de la app, fichas verificadas y, como ultimo recurso, IA)
/// ============================================================================

/// Sesion de conversacion con Carmen. Es de un usuario en una empresa: solo
/// ese usuario la lee o la borra (companyId + userId en cada consulta).
model ChatSession {
  id        String        @id @default(cuid())
  companyId String
  userId    String
  /// Primeras palabras de la primera pregunta, para el historial.
  titulo    String?       @db.VarChar(120)
  /// Estado del dialogo que solo lee el servidor: { intencion, huecos, pendiente?, en }.
  contexto  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([companyId])
  @@index([userId])
  @@index([companyId, userId, updatedAt])
}

/// Mensaje (usuario o asistente) dentro de una sesion de Carmen.
model ChatMessage {
  id               String    @id @default(cuid())
  sessionId        String
  companyId        String
  userId           String
  role             String // user | assistant
  content          String    @db.Text
  sources          Json? // Fuentes citadas (solo mensajes antiguos, de antes del enrutador)
  /// De donde sale la respuesta: datos | faq | ia | aclaracion | sistema.
  origen           String?   @db.VarChar(12)
  /// Intencion de datos que se ejecuto (INT-24...).
  intencion        String?   @db.VarChar(40)
  /// Huecos de la intencion (periodo, ids), sin nombres de terceros.
  huecos           Json?
  /// Bloques de la respuesta (kpis, tabla de 15 filas como maximo, enlaces, botones) para repintar el historial.
  datos            Json?
  /// Permiso con el que se calculo la respuesta: si el usuario lo pierde, el historial la oculta.
  permisoRequerido String?   @db.VarChar(120)
  calculadoEn      DateTime?
  /// Valoracion del usuario: 1 util, 0 no util.
  valoracion       Int?
  /// Resultado del validador de cifras de la IA: ok | descartada.
  validacion       String?   @db.VarChar(12)
  createdAt        DateTime  @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([companyId])
  @@index([createdAt])
  @@index([companyId, userId, createdAt])
  @@index([origen, createdAt])
}

/// Contadores de uso de Carmen, compartidos entre instancias serverless.
/// Claves: 'global:2026-10' (coste del mes), 'empresa:{id}:2026-10-07' y
/// 'usuario:{id}:2026-10-07' (consultas a la IA y mensajes del dia),
/// 'empresa:{id}:2026-10' (uso del mes, solo informativo).
/// La purga diaria borra las diarias a los 40 dias y las mensuales a los 13 meses.
model CarmenContador {
  clave         String   @id @db.VarChar(120)
  consultasIA   Int      @default(0)
  /// Coste reservado o liquidado en dolares (precios de la API).
  costeUsd      Decimal  @default(0) @db.Decimal(12, 6)
  mensajes      Int      @default(0)
  actualizadoEn DateTime @updatedAt
}

/// Auditoria de cada llamada a la IA. No guarda el texto de la pregunta.
/// La purga diaria la borra a los 13 meses.
model CarmenLlamadaIA {
  id                   String   @id @default(cuid())
  companyId            String
  userId               String
  mensajeId            String?
  modelo               String   @db.VarChar(60)
  tokensEntrada        Int      @default(0)
  tokensSalida         Int      @default(0)
  tokensCacheEscritura Int      @default(0)
  tokensCacheLectura   Int      @default(0)
  reservaUsd           Decimal  @default(0) @db.Decimal(12, 6)
  costeUsd             Decimal  @default(0) @db.Decimal(12, 6)
  /// ok | error | descartada | sin_tope
  estado               String   @db.VarChar(12)
  motivo               String?  @db.VarChar(120)
  duracionMs           Int?
  createdAt            DateTime @default(now())

  @@index([companyId, createdAt])
}

/// Ajustes de Carmen por empresa. La IA viene apagada y solo la enciende un
/// administrador de la empresa (o el admin global).
model CarmenAjustes {
  companyId        String   @id
  iaActiva         Boolean  @default(false)
  /// Tope propio de preguntas a la IA por dia en la empresa (solo puede bajar el general).
  topeConsultasDia Int?
  /// Dias que se guardan las conversaciones.
  conservarDias    Int      @default(90)
  actualizadoPor   String?
  actualizadoEn    DateTime @updatedAt
}

/// Libro de retenciones (IRPF, otros)
model RetentionBook {
  id                  String   @id @default(cuid())
  companyId           String
  ano                 Int
  /// Mes del ejercicio (1-12). Nullable: registros creados antes de esta columna
  /// no lo tienen y los informes caen a la aproximacion por año (ver reports.service).
  mes                 Int?
  tipoRetencionNombre String // PROFESIONAL, ASALARIADO
  nifTercero          String
  nombreTercero       String
  baseImponible       Decimal  @db.Decimal(14, 2)
  porcentajeRetencion Int // 7, 15, 19%
  cuotaRetencion      Decimal  @db.Decimal(14, 2)
  asientoId           String?
  createdAt           DateTime @default(now())

  @@index([companyId])
  @@index([ano])
  @@index([ano, mes])
  @@index([tipoRetencionNombre])
}

/// ============================================================================
/// FACTURAS DE GASTO (COMPRAS / SERVICIOS RECIBIDOS)
/// ============================================================================

/// Proveedor (acreedor que nos emite facturas de gasto).
/// Espejo de Customer pero para el lado pasivo (cuentas 400).
model Supplier {
  id           String                @id @default(cuid())
  companyId    String
  nombreFiscal String
  nifCif       String
  direccion    String?
  pais         String                @default("ES")
  provincia    String?
  municipio    String?
  cp           String?
  email        String?
  telefono     String?
  activo       Boolean               @default(true)
  /// Subcuentas propias con el MISMO correlativo: 400N (compras) y 410N
  /// (servicios). Se asignan las dos al dar de alta la ficha; en el plan solo
  /// se da de alta la que se usa, al primer apunte (services/terceros).
  subcuenta400 String?               @db.VarChar(15)
  subcuenta410 String?               @db.VarChar(15)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  invoices     ExpenseInvoice[]
  contacts     SupplierContact[]
  bankAccounts SupplierBankAccount[]
  /// Inmuebles que nos alquila (modelo 180).
  inmuebles    InmuebleArrendado[]

  @@unique([companyId, nifCif])
  @@unique([companyId, subcuenta400])
  @@unique([companyId, subcuenta410])
  @@index([companyId])
}

/// Factura de gasto (dinero que debemos pagar = compra/servicio recibido).
/// Espejo de IncomeInvoice para el ciclo de compras.
model ExpenseInvoice {
  id               String               @id @default(cuid())
  companyId        String
  supplierId       String
  serie            String
  numero           Int
  numeroCompleto   String // serie + numero formateado
  fechaEmision     String // YYYY-MM-DD
  fechaVencimiento String // YYYY-MM-DD
  /// DRAFT (del lector, asiento en borrador) | PENDING | OVERDUE | CONFIRMED (anteriores, sin contabilizar) | ACCOUNTED | ANULADA
  estado           String               @default("DRAFT")
  /// Tipo de gasto PGC: COMPRA | SERVICIO_PROFESIONAL | ALQUILER | SUMINISTROS
  tipoGasto        String               @default("COMPRA")
  baseTotal        Decimal              @default(0) @db.Decimal(14, 2)
  ivaTotal         Decimal              @default(0) @db.Decimal(14, 2)
  /// Tipo de IVA principal aplicado (0, 4, 10, 21)
  tipoIva          Int                  @default(21)
  retencionTotal   Decimal              @default(0) @db.Decimal(14, 2)
  /// Tipo de retención IRPF (0, 7, 15, 19)
  tipoRetencion    Int                  @default(0)
  /// Importe neto a pagar al proveedor = base + IVA - retención
  totalFactura     Decimal              @default(0) @db.Decimal(14, 2)
  /// Estado de PAGO (aparte de `estado`): PENDIENTE | PARCIAL | PAGADA.
  /// Lo recalculan los pagos registrados (InvoicePayment GASTO).
  estadoPago       String               @default("PENDIENTE")
  observaciones    String?              @db.Text
  /// Numero que puso el PROVEEDOR en su factura ("F2026/0012"). Obligatorio en
  /// las altas nuevas; null en las anteriores. Va al libro de IVA de recibidas.
  numeroFacturaProveedor String?  @db.VarChar(60)
  /// Copia normalizada (mayusculas, sin espacios) mientras la factura NO esta
  /// anulada; null si esta anulada o es anterior. Solo sirve para el indice
  /// unico: el mismo numero del mismo proveedor no se registra dos veces, pero
  /// una factura anulada se puede volver a registrar con su numero.
  numeroProveedorActivo  String?  @db.VarChar(60)
  /// Fecha de registro (AAAA-MM-DD): la del asiento, el libro de IVA y los
  /// modelos si la factura se recibio tarde. null = fechaEmision.
  fechaRegistro          String?
  /// Anulacion: fecha (AAAA-MM-DD), motivo y contraasiento (null si se anulo
  /// marcando el asiento REVERSED con el periodo abierto).
  anuladaEn              String?
  motivoAnulacion        String?  @db.Text
  anulacionAsientoId     String?
  /// 349 de las compras a otro pais de la UE desde 2027: A (bienes) o I
  /// (servicios). null = segun el tipo de gasto (COMPRA = A; el resto = I).
  clave349               String?  @db.VarChar(1)
  /// 180: inmueble de una factura de ALQUILER. null = el unico inmueble activo
  /// del arrendador (si tiene varios, hay que elegirlo).
  inmuebleArrendadoId    String?
  /// Rectificativa o abono recibido del proveedor (importes con signo: en
  /// negativo si baja, en positivo si sube). domain/rectificativa-gasto.model.ts.
  esRectificativa        Boolean  @default(false)
  /// I = por diferencias. S = por sustitucion (tambien se guarda la diferencia;
  /// la factura corregida va en datosSustitucion).
  tipoRectificativa      String?  @db.VarChar(1)
  /// DEVOLUCION | DESCUENTO | RAPPEL | PRONTO_PAGO | ANULACION_PRECIO | ERROR_IVA | ERROR_DERECHO
  causaRectificacion     String?  @db.VarChar(16)
  /// Motivo tal como lo pone el proveedor o lo escribe el usuario.
  motivoRectificacion    String?  @db.Text
  /// Rappels y descuentos por volumen: periodo al que se refieren (art. 15.4 RD 1619/2012).
  rectificaDesde         String?  @db.VarChar(10)
  rectificaHasta         String?  @db.VarChar(10)
  /// Fecha que cuenta en el 303, el 390 y el libro de IVA cuando no es la
  /// contable: solo en ERROR_IVA que reduce la deduccion (el periodo de la
  /// original, art. 114 LIVA). null = fechaContableGasto. El 347, el 349 y las
  /// retenciones siguen la contable.
  fechaImputacionIva     String?  @db.VarChar(10)
  /// Cuando se confirmo «Registrar y avisarme de rectificar el 303».
  rectificar303ConfirmadoEn String? @db.VarChar(25)
  /// Abono de una factura de fuera de la app que no estaba pagada («No, se
  /// descuenta de lo que le debo»): al contabilizarlo (alta o aprobacion del
  /// borrador del lector) se aplica a ella. null = no se pregunto.
  compensarFuera         Boolean?
  /// Sustitucion: lineas y totales de la factura corregida tal como los manda el proveedor (informativo).
  datosSustitucion       Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  lineas           ExpenseInvoiceLine[]
  supplier         Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  inmuebleArrendado InmuebleArrendado?  @relation(fields: [inmuebleArrendadoId], references: [id], onDelete: SetNull)
  rectifica        ExpenseInvoiceRectificada[] @relation("Rectificativa")
  rectificadaPor   ExpenseInvoiceRectificada[] @relation("Original")

  @@unique([companyId, serie, numero])
  // El mismo numero del mismo proveedor no se registra dos veces (las anuladas no cuentan: null).
  @@unique([companyId, supplierId, numeroProveedorActivo])
  // Unico DENTRO de cada empresa: antes era unico en toda la BD, y dos empresas
  // no podian tener cada una su factura 2026-1.
  @@unique([companyId, numeroCompleto])
  @@index([companyId, estado])
  @@index([supplierId])
  @@index([inmuebleArrendadoId])
  @@index([companyId, esRectificativa])
}

/// Que rectifica una rectificativa de gasto: una o varias facturas (de la app
/// o de fuera) o un periodo (rappel). Art. 15.4 RD 1619/2012.
model ExpenseInvoiceRectificada {
  id                   String          @id @default(cuid())
  companyId            String
  rectificativaId      String
  /// Original registrada en la app. null: de antes de la app o llevada fuera.
  originalId           String?
  /// Numero que puso el proveedor en la original y su fecha de expedicion.
  /// Obligatorios sin originalId (se copian de la original si la hay).
  numeroOriginal       String?         @db.VarChar(60)
  fechaOriginal        String?         @db.VarChar(10)
  /// Fila de periodo (rappel): desde y hasta. Excluye originalId y numeroOriginal.
  periodoDesde         String?         @db.VarChar(10)
  periodoHasta         String?         @db.VarChar(10)
  /// Parte de la rectificacion que toca a esta fila, con signo. Nombres
  /// propios: CAMPOS_DECIMALES va por nombre en todos los modelos.
  baseRectificada      Decimal?        @db.Decimal(14, 2)
  cuotaRectificada     Decimal?        @db.Decimal(14, 2)
  retencionRectificada Decimal?        @db.Decimal(14, 2)
  rectificativa        ExpenseInvoice  @relation("Rectificativa", fields: [rectificativaId], references: [id], onDelete: Cascade)
  original             ExpenseInvoice? @relation("Original", fields: [originalId], references: [id], onDelete: Restrict)

  @@index([companyId, originalId])
  @@index([rectificativaId])
}

/// Aplicacion de un abono de proveedor (ExpenseInvoice con total < 0) a una
/// factura del mismo proveedor, sin movimiento de dinero.
model CompensacionGasto {
  id             String   @id @default(cuid())
  companyId      String
  abonoId        String
  /// null: factura de fuera de la app (2026 llevada fuera). Entonces son
  /// obligatorios numeroFuera y fechaFuera.
  facturaId      String?
  numeroFuera    String?  @db.VarChar(60)
  fechaFuera     String?  @db.VarChar(10)
  fecha          String   @db.VarChar(10)
  /// Positivo: lo que se descuenta de la factura y del abono.
  importe        Decimal  @db.Decimal(14, 2)
  /// AUTO (al contabilizar el abono, contra su original) | MANUAL
  origen         String   @db.VarChar(6)
  /// ACTIVO | ANULADO
  estado         String   @default("ACTIVO") @db.VarChar(8)
  /// Asiento de traspaso si abono y factura van a subcuentas distintas (400N
  /// frente a 410N), con origen TESORERIA e invoiceId null. null si comparten subcuenta.
  journalEntryId String?
  userId         String?
  anuladaEn      String?  @db.VarChar(10)
  createdAt      DateTime @default(now())

  @@index([companyId, abonoId])
  @@index([companyId, facturaId])
}

/// Inmueble urbano que nos alquila un proveedor (modelo 180: un registro por
/// arrendador e inmueble). La direccion va por partes, como pide el diseno de
/// registro de la AEAT.
model InmuebleArrendado {
  id                  String           @id @default(cuid())
  companyId           String
  supplierId          String
  /// 1 territorio comun, 2 Pais Vasco, 3 Navarra (con referencia catastral); 4 sin referencia catastral.
  situacion           Int              @default(1)
  referenciaCatastral String?          @db.VarChar(20)
  /// Codigo de tipo de via del INE (CL, AV, PZ...).
  tipoVia             String           @db.VarChar(5)
  nombreVia           String           @db.VarChar(50)
  /// NUM, KM. o S/N.
  tipoNumeracion      String           @default("NUM") @db.VarChar(3)
  numeroCasa          String?          @db.VarChar(5)
  calificadorNumero   String?          @db.VarChar(3)
  bloque              String?          @db.VarChar(3)
  portal              String?          @db.VarChar(3)
  escalera            String?          @db.VarChar(3)
  planta              String?          @db.VarChar(3)
  puerta              String?          @db.VarChar(3)
  complemento         String?          @db.VarChar(40)
  /// Solo si es distinta del municipio.
  localidad           String?          @db.VarChar(30)
  municipio           String           @db.VarChar(30)
  /// Codigo INE del municipio (5 cifras).
  codigoMunicipio     String           @db.VarChar(5)
  /// Provincia del inmueble (01-53).
  codigoProvincia     String           @db.VarChar(2)
  codigoPostal        String           @db.VarChar(5)
  activo              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  supplier            Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  facturas            ExpenseInvoice[]

  @@index([companyId, supplierId])
}

/// Cobro de una factura de venta (INGRESO) o pago de una factura de gasto
/// (GASTO), con su asiento de tesoreria (572/570 contra 430 o 400/410).
/// Anular no borra: deja estado ANULADO y el asiento REVERSED (o un
/// contraasiento si el periodo del cobro ya esta cerrado).
model InvoicePayment {
  id               String    @id @default(cuid())
  companyId        String
  /// INGRESO (cobro) | GASTO (pago)
  invoiceType      String
  invoiceId        String
  fecha            String // YYYY-MM-DD
  /// Importe en moneda de cuenta aplicado a la cuenta del tercero (430/400) al
  /// tipo de la factura. En los cobros en la moneda de cuenta coincide con lo
  /// que entra en tesoreria.
  importe          Decimal   @db.Decimal(14, 2)
  /// Moneda de la factura cobrada.
  moneda           String    @default("EUR") @db.VarChar(3)
  /// En la moneda de la factura; reduce lo pendiente. null = importe.
  importeDoc       Decimal?  @db.Decimal(14, 2)
  /// En moneda de cuenta, lo que entra o sale de la 572/570. null = importe.
  importeTesoreria Decimal?  @db.Decimal(14, 2)
  /// Unidades de la moneda de la factura por 1 de la moneda de cuenta, al cobrar.
  tipoCambio       Decimal   @default(1) @db.Decimal(18, 8)
  /// PAR | BCE | MANUAL | BANCO
  fuenteTipoCambio String    @default("PAR") @db.VarChar(10)
  /// Diferencia de cambio en moneda de cuenta: > 0 a la 768, < 0 a la 668.
  diferenciaCambio Decimal   @default(0) @db.Decimal(14, 2)
  /// Comision bancaria en moneda de cuenta (626).
  comisionBancaria Decimal   @default(0) @db.Decimal(14, 2)
  /// Subcuenta de tesoreria: la 572xxx de la cuenta bancaria o la 570 de caja.
  cuentaTesoreria  String
  bankAccountId    String?
  nota             String?   @db.Text
  /// Asiento del cobro/pago (JournalEntry).
  journalEntryId   String?
  /// ACTIVO | ANULADO
  estado           String    @default("ACTIVO")
  anuladoEn        DateTime?
  /// Contraasiento de la anulacion, si el asiento original no se pudo marcar REVERSED.
  anulacionEntryId String?
  createdBy        String?
  createdAt        DateTime  @default(now())

  @@index([companyId, invoiceType, invoiceId])
  @@index([companyId, estado])
}

/// Línea de factura de gasto.
model ExpenseInvoiceLine {
  id                  String         @id @default(cuid())
  invoiceId           String
  descripcion         String
  cantidad            Float
  precioUnitario      Decimal        @db.Decimal(14, 4)
  baseLine            Decimal        @db.Decimal(14, 2)
  descuentoPorcentaje Float          @default(0)
  descuentoImporte    Decimal        @default(0) @db.Decimal(14, 2)
  tipoIva             Int            @default(21)
  ivaImporte          Decimal        @default(0) @db.Decimal(14, 2)
  tipoRetencion       Int            @default(0)
  retencionImporte    Decimal        @default(0) @db.Decimal(14, 2)
  /// Código PGC de gasto (ej. "600", "622", "621")
  accountCode         String?
  invoice             ExpenseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// ============================================================================
/// PRODUCTOS (catálogo; migrado de FacturaScripts a Prisma, épico FS->Prisma)
/// ============================================================================

/// Producto o servicio del catalogo, para rellenar las lineas de las facturas.
/// `referencia` es el codigo del producto (unico en la empresa).
model Product {
  id            String         @id @default(cuid())
  companyId     String
  referencia    String
  descripcion   String?
  /// Precio de venta SIN IVA.
  precio        Decimal        @default(0) @db.Decimal(14, 4)
  stock         Float          @default(0)
  /// true = no se ofrece en las facturas (producto dado de baja).
  bloqueado     Boolean        @default(false)
  /// PRODUCTO | SERVICIO
  tipo          String         @default("PRODUCTO")
  /// Unidad de medida: ud, h, kg, m, m2, l...
  unidad        String         @default("ud")
  ivaPorcentaje Decimal        @default(21) @db.Decimal(5, 2)
  /// Precio de compra sin IVA (para ver el margen), opcional.
  precioCompra  Decimal?       @db.Decimal(14, 4)
  /// Cuenta de ventas propia (si no, la de la familia; si no, 700/705).
  cuentaVentas  String?
  notas         String?        @db.Text
  familiaId     String?
  familia       ProductFamily? @relation(fields: [familiaId], references: [id], onDelete: SetNull)
  /// Unidades por pack (plantilla A): propone Uds = packs x unidades.
  unidadesPorPack   Int?
  /// Kg de plastico no reciclado POR UNIDAD (IEEPNR, Ley 7/2022).
  kgPlasticoUnidad  Decimal? @db.Decimal(14, 6)
  /// El articulo lleva IEEPNR: se proponen sus kg en la factura.
  llevaIeepnr       Boolean  @default(false)
  /// Texto adicional del articulo en la factura (varias lineas).
  textoFactura      String?  @db.Text
  /// Formato del articulo (plantilla B de ceramica): 23,3x120.
  formato           String?  @db.VarChar(40)
  /// Metros cuadrados por caja (plantilla B): propone m2 = cajas x m2 por caja.
  metros2PorCaja    Decimal? @db.Decimal(14, 4)
  /// Piezas por caja (plantilla B): propone piezas = cajas x piezas por caja.
  piezasPorCaja     Int?
  /// Unidad del precio por defecto (plantilla B): M2 | PIEZA | UNIDAD.
  unidadPrecio      String?  @db.VarChar(10)
  /// Kg por unidad del precio (por m2, por pieza o por unidad): propone el peso de la linea.
  pesoKgPorUnidad   Decimal? @db.Decimal(14, 4)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([companyId, referencia])
  @@index([companyId])
  @@index([familiaId])
}

/// Familia de productos, con codigo propio y una sola capa de subfamilias.
model ProductFamily {
  id            String          @id @default(cuid())
  companyId     String
  codigo        String
  nombre        String
  /// IVA que se propone a los productos nuevos de la familia.
  ivaPorcentaje Decimal?        @db.Decimal(5, 2)
  /// Cuenta de ventas de la familia (700, 705, 7000001...).
  cuentaVentas  String?
  parentId      String?
  parent        ProductFamily?  @relation("Subfamilias", fields: [parentId], references: [id], onDelete: Cascade)
  hijas         ProductFamily[] @relation("Subfamilias")
  productos     Product[]
  activa        Boolean         @default(true)
  createdAt     DateTime        @default(now())

  @@unique([companyId, codigo])
  @@index([companyId])
}

/// ============================================================================
/// BANCOS (sustituye almacenamiento en memoria de bancos.service.ts)
/// ============================================================================

/// Cuenta bancaria de la empresa.
model BankAccount {
  id              String         @id @default(cuid())
  companyId       String
  iban            String
  bancoNombre     String?
  /// Referencia a subcuenta 572xxx del plan contable.
  subcuentaCodigo String
  bic             String?
  /// Saldo que el usuario declara al dar de alta la cuenta (pantalla de tesoreria).
  saldoInicial    Decimal        @default(0) @db.Decimal(14, 2)
  /// Fecha (AAAA-MM-DD) a la que corresponde saldoInicial. Null = como hasta ahora.
  fechaSaldoInicial    String?  @db.VarChar(10)
  /// Saldo de la 572 en la apertura, para ensenar la diferencia con el extracto.
  saldoContableInicial Decimal? @db.Decimal(14, 2)
  /// Moneda de la cuenta (ISO 4217). Al darla de alta, la moneda de cuenta de la empresa.
  moneda          String         @default("EUR") @db.VarChar(3)
  activa          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  movimientos     BankMovement[]

  @@index([companyId])
}

/// Movimiento bancario importado (CSV o norma43).
model BankMovement {
  id               String              @id @default(cuid())
  companyId        String
  cuentaBancariaId String
  /// YYYY-MM-DD
  fecha            String
  importe          Decimal             @db.Decimal(14, 2)
  concepto         String
  referencia       String?
  /// 'norma43' | 'csv'
  origen           String
  conciliado       Boolean             @default(false)
  /// Categoria analitica de tesoreria (no es una cuenta contable). Ver TreasuryCategory.
  categoriaId      String?
  /// IVA del movimiento, opcional (para el analisis con o sin impuestos).
  ivaPorcentaje    Decimal?            @db.Decimal(5, 2)
  /// Movimientos que no cuentan en el analisis (traspasos entre cuentas propias...).
  ignorado         Boolean             @default(false)
  createdAt        DateTime            @default(now())
  cuentaBancaria   BankAccount         @relation(fields: [cuentaBancariaId], references: [id], onDelete: Cascade)
  categoria        TreasuryCategory?   @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  partes           BankMovementSplit[]

  @@index([companyId])
  @@index([cuentaBancariaId])
  @@index([categoriaId])
}

/// Categoria analitica de tesoreria (Ventas, Proveedores, Marketing...), con
/// subcategorias. NO es una cuenta del plan contable: sirve para analizar cobros y
/// pagos y hacer previsiones.
model TreasuryCategory {
  id            String                 @id @default(cuid())
  companyId     String
  /// INGRESO | GASTO
  tipo          String
  nombre        String
  /// Color en hexadecimal (#16a34a)
  color         String
  /// IVA habitual de la categoria, opcional; se propone al categorizar.
  ivaPorcentaje Decimal?               @db.Decimal(5, 2)
  parentId      String?
  orden         Int                    @default(0)
  activa        Boolean                @default(true)
  createdAt     DateTime               @default(now())
  parent        TreasuryCategory?      @relation("Subcategorias", fields: [parentId], references: [id], onDelete: Cascade)
  hijas         TreasuryCategory[]     @relation("Subcategorias")
  movimientos   BankMovement[]
  partes        BankMovementSplit[]
  reglas        TreasuryCategoryRule[]

  @@index([companyId, tipo])
}

/// Regla de autocategorizacion: los movimientos cuyo concepto da esta clave
/// ("agua", "endesa"...) van a esta categoria.
model TreasuryCategoryRule {
  id          String           @id @default(cuid())
  companyId   String
  /// INGRESO | GASTO (un cobro y un pago con el mismo concepto pueden ir a categorias distintas)
  tipo        String
  clave       String
  categoriaId String
  createdAt   DateTime         @default(now())
  categoria   TreasuryCategory @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([companyId, tipo, clave])
}

/// Parte de un movimiento desglosado en varias categorias. El movimiento
/// original se queda tal cual (cuadre de bancos, conciliacion); las partes solo
/// cuentan en el analisis de tesoreria y suman exactamente su importe.
model BankMovementSplit {
  id            String            @id @default(cuid())
  movementId    String
  importe       Decimal           @db.Decimal(14, 2)
  categoriaId   String?
  ivaPorcentaje Decimal?          @db.Decimal(5, 2)
  concepto      String?
  createdAt     DateTime          @default(now())
  movimiento    BankMovement      @relation(fields: [movementId], references: [id], onDelete: Cascade)
  categoria     TreasuryCategory? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  @@index([movementId])
}

/// ============================================================================
/// CONFIGURACION DE CIERRE (sustituye almacenamiento en memoria de cierreConfig.service.ts)
/// ============================================================================

/// Configuracion de cierre contable por empresa (controla el bloqueo por descuadre bancario).
model CompanyCierreConfig {
  companyId          String   @id
  exigirCuadreBancos Boolean  @default(true)
  /// Tolerancia de descuadre en EUR.
  toleranciaCuadre   Float    @default(0.01)
  updatedAt          DateTime @updatedAt
}

/// ============================================================================
/// SEGURIDAD: REVOCACION DE REFRESH TOKENS
/// ============================================================================

/// jti de refresh tokens revocados (logout o reuso detectado tras rotacion).
/// Permite invalidar un refresh token robado antes de que expire (7 dias).
/// Las filas con expiresAt en el pasado se limpian de forma oportunista en
/// cada llamada a /auth/refresh (ver auth.service.ts) — no requiere cron.
model RevokedToken {
  jti       String   @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// ============================================================================
/// NOMINAS (sustituye almacenamiento en memoria de nominas.service.ts)
/// ============================================================================

/// Resumen de nominas por mes (solo totales), de antes de que existieran las
/// nominas por trabajador. Ya no se crean filas nuevas (POST /nominas/resumen
/// responde 400): se leen solo para los meses sin nominas por trabajador, y si
/// un mes tiene varias se usa la ultima (ver nominas.service.ts).
model NominaResumen {
  id                             String   @id @default(cuid())
  companyId                      String
  mes                            Int
  ejercicio                      Int
  totalBruto                     Decimal  @db.Decimal(14, 2)
  totalSeguridadSocialEmpresa    Decimal  @default(0) @db.Decimal(14, 2)
  totalSeguridadSocialTrabajador Decimal  @default(0) @db.Decimal(14, 2)
  totalIRPF                      Decimal  @default(0) @db.Decimal(14, 2)
  totalLiquido                   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt                      DateTime @default(now())

  @@index([companyId])
  @@index([companyId, ejercicio])
}

/// Trabajador de la empresa, para registrar sus nominas. Lo ven y editan solo
/// los usuarios con nominas:read / nominas:write (admin y contable).
/// `discapacidad` es un dato de salud (art. 9 RGPD): opcional y solo para el 190.
model Empleado {
  id                   String   @id @default(cuid())
  companyId            String
  /// NIF o NIE en mayusculas, sin espacios ni guiones (con letra de control valida).
  nif                  String
  nombre               String
  apellidos            String   @default("")
  /// Numero de afiliacion a la Seguridad Social (12 digitos, con control).
  naf                  String?
  fechaAlta            String? // YYYY-MM-DD
  fechaBaja            String? // YYYY-MM-DD
  /// INDEFINIDO | TEMPORAL | FIJO_DISCONTINUO | FORMACION | OTRO
  tipoContrato         String   @default("INDEFINIDO")
  jornadaParcial       Boolean  @default(false)
  grupoCotizacion      Int?
  /// Informativo: el que cuenta es el de cada nomina.
  porcentajeIrpfActual Decimal? @db.Decimal(5, 2)
  clave190             String   @default("A")
  subclave190          String?
  /// Codigo de provincia (2 digitos) para el 190.
  provincia            String?
  anioNacimiento       Int?
  situacionFamiliar    Int? // 1 | 2 | 3
  nifConyuge           String?
  discapacidad         Int? // 0 | 1 | 2 | 3
  movilidadGeografica  Boolean?
  /// Subcuenta 465 propia (remuneraciones pendientes de pago). Se crea en el
  /// plan de la empresa al contabilizar su primera nomina.
  subcuenta465         String?
  activo               Boolean  @default(true)
  observaciones        String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  nominas              Nomina[]

  @@unique([companyId, nif])
  @@index([companyId, activo])
}

/// Nomina de un trabajador en un mes (una por trabajador, mes y tipo). La
/// calcula la gestoria; aqui se registra, se valida su cuadre y se contabiliza
/// con un asiento propio (origen NOMINA, invoiceId = id de la nomina).
model Nomina {
  id                        String    @id @default(cuid())
  companyId                 String
  empleadoId                String
  ejercicio                 Int
  /// Mes de devengo (1-12).
  mes                       Int
  /// ORDINARIA | EXTRA | ATRASOS | FINIQUITO | COMPLEMENTARIA
  tipo                      String    @default("ORDINARIA")
  /// Ejercicio al que corresponden los atrasos, si es otro (190).
  ejercicioDevengo          Int?
  /// Ultimo dia del mes de devengo: fecha del asiento (YYYY-MM-DD).
  fechaDevengo              String
  /// Fecha de pago (YYYY-MM-DD); por defecto, la de devengo.
  fechaPago                 String
  /// Fecha de pago que tenia antes de registrar el pago de los liquidos: se
  /// restaura al anular el pago (el 111 va por fecha de pago).
  fechaPagoAnterior         String?
  brutoDinerario            Decimal   @default(0) @db.Decimal(14, 2)
  dietasExentas             Decimal   @default(0) @db.Decimal(14, 2)
  especieValoracion         Decimal   @default(0) @db.Decimal(14, 2)
  ingresoACuenta            Decimal   @default(0) @db.Decimal(14, 2)
  ingresoACuentaRepercutido Boolean   @default(false)
  indemnizacionExenta       Decimal   @default(0) @db.Decimal(14, 2)
  indemnizacionSujeta       Decimal   @default(0) @db.Decimal(14, 2)
  ssTrabajador              Decimal   @default(0) @db.Decimal(14, 2)
  irpf                      Decimal   @default(0) @db.Decimal(14, 2)
  porcentajeIrpf            Decimal?  @db.Decimal(5, 2)
  anticipos                 Decimal   @default(0) @db.Decimal(14, 2)
  embargos                  Decimal   @default(0) @db.Decimal(14, 2)
  otrasDeducciones          Decimal   @default(0) @db.Decimal(14, 2)
  liquido                   Decimal   @default(0) @db.Decimal(14, 2)
  ssEmpresa                 Decimal   @default(0) @db.Decimal(14, 2)
  /// BORRADOR | CONTABILIZADA | PAGADA | ANULADA
  estado                    String    @default("BORRADOR")
  /// Asiento de devengo (JournalEntry) mientras esta CONTABILIZADA o PAGADA.
  asientoId                 String?
  /// Contraasiento, si se anulo con el periodo del asiento ya cerrado.
  asientoAnulacionId        String?
  anuladaEn                 DateTime?
  /// Asiento del pago del liquido (465 del trabajador contra 572/570). Lo
  /// comparten las nominas que se pagan juntas (por ejemplo, todas las del mes).
  asientoPagoId             String?
  /// Subcuenta de tesoreria del pago (572xxx de la cuenta bancaria o 570 de caja).
  cuentaPago                String?
  /// Importacion de la que viene (mismo valor para todas las filas de un Excel).
  loteImportacionId         String?
  /// manual | importacion
  origen                    String    @default("manual")
  observaciones             String?   @db.Text
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  empleado                  Empleado  @relation(fields: [empleadoId], references: [id], onDelete: Restrict)

  @@unique([companyId, empleadoId, ejercicio, mes, tipo])
  @@index([companyId, ejercicio, mes])
  @@index([companyId, fechaPago])
  @@index([empleadoId])
  @@index([companyId, asientoPagoId])
}

/// Seguros sociales de un mes (recibo de liquidacion de cotizaciones, RLC).
/// Lo previsto sale de las nominas contabilizadas del mes (SS trabajador + SS
/// empresa, en la 476). Al pagar se guarda lo que dice el RLC: la diferencia con
/// lo previsto va a la 642 y la IT compensada (pago delegado) a la 471.
model LiquidacionSS {
  id                 String    @id @default(cuid())
  companyId          String
  ejercicio          Int
  mes                Int
  /// NORMAL | COMPLEMENTARIA
  tipo               String    @default("NORMAL")
  /// SS trabajador de las nominas del mes (al pagar, la que se paga).
  cuotaObrera        Decimal   @default(0) @db.Decimal(14, 2)
  /// SS empresa de las nominas del mes (al pagar, la que se paga).
  cuotaPatronal      Decimal   @default(0) @db.Decimal(14, 2)
  /// Suma de las dos: lo que hay en la 476 por las nominas del mes.
  totalPrevisto      Decimal   @default(0) @db.Decimal(14, 2)
  /// Importe a pagar del RLC real (null: se paga lo previsto).
  totalRlc           Decimal?  @db.Decimal(14, 2)
  /// Compensacion por IT en pago delegado (descuenta del RLC, va a la 471).
  compensacionIt     Decimal   @default(0) @db.Decimal(14, 2)
  /// YYYY-MM-DD; por defecto, el ultimo dia del mes siguiente.
  fechaCargoPrevista String
  /// PENDIENTE | PAGADA
  estado             String    @default("PENDIENTE")
  /// Asiento del pago (476 y ajustes contra 572/570).
  asientoPagoId      String?
  fechaPago          String?
  cuentaPago         String?
  observaciones      String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([companyId, ejercicio, mes, tipo])
  @@index([companyId, estado])
}

/// ============================================================================
/// REGISTRO MERCANTIL: legalización de libros + depósito de cuentas anuales.
/// La API NO firma (no gestiona certificados): genera artefactos (PDF/A, ZIP,
/// hashes) y registra el estado de la presentación telemática. Ver
/// docs/ADR-003-registro-mercantil.md.
/// ============================================================================

/// Configuración legal/societaria por empresa (1-1 con Company).
model LegalConfig {
  id                         String   @id @default(cuid())
  companyId                  String   @unique
  tipoSociedad               String   @default("SL") // SA, SL, SLU (unipersonal), SCP, etc.
  ejercicioInicio            String   @default("01-01") // MM-DD de inicio del ejercicio
  ejercicioFin               String   @default("12-31") // MM-DD de cierre del ejercicio
  obligaLibroSocios          Boolean  @default(true) // Libro registro de socios/acciones
  obligaLibroContratos       Boolean  @default(false) // Solo sociedades unipersonales
  registroMercantilProvincia String? // Provincia del Registro Mercantil del domicilio social
  // Identificacion de la sociedad para las cuentas anuales y la memoria.
  denominacion               String?
  nif                        String?
  domicilioSocial            String?
  codigoPostal               String?
  municipio                  String?
  provincia                  String?
  actividad                  String?  @db.Text // Actividad principal (nota 1 de la memoria)
  cnae                       String?
  datosRegistrales           String? // Tomo, folio, hoja e inscripcion
  // Inscripcion en el Registro Mercantil por partes (sale al pie de las facturas).
  registroTomo               String?
  registroFolio              String?
  registroHoja               String?
  registroInscripcion        String?
  // Pais de la empresa (ISO 3166-1 alfa-2). Fuera de ES no se aplican las
  // validaciones ni los requisitos espanoles (NIF, CP, Registro Mercantil).
  pais                       String   @default("ES")
  // Moneda de la contabilidad (ISO 4217): la de las columnas de importe, los
  // asientos y los informes. EUR obligatoria si pais = ES; las empresas de EE. UU.
  // y Hong Kong trabajan en USD. No cambia si ya hay facturas o asientos.
  // El idioma y el formato de las facturas salen del pais (ES espanol; resto ingles).
  monedaCuenta               String   @default("EUR") @db.VarChar(3)
  // Contacto de la empresa (sale en las facturas).
  telefono                   String?
  email                      String?
  web                        String?
  // Persona de contacto de los modelos informativos de la AEAT (349, 180...):
  // apellidos y nombre, en ese orden.
  personaContacto            String?  @db.VarChar(80)
  // Datos estadísticos de la página 1 del 390 (apartado 3) de la actividad
  // principal: clave (A01 arrendadores de inmuebles, A03 resto de actividades
  // empresariales...) y epígrafe del IAE sin puntos (6151, 841...).
  claveActividad             String?  @db.VarChar(3)
  epigrafeIae                String?  @db.VarChar(4)
  fechaConstitucion          String? // YYYY-MM-DD
  // Logo para las facturas (PNG o JPG, maximo 1 MB). En la BD y no en el
  // almacenamiento de ficheros: es pequeno y asi no depende de Vercel Blob.
  logo                       Bytes?   @db.MediumBlob
  logoMime                   String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

/// Valores por defecto de facturacion (1:1 con la empresa). Sin fila, los de
/// siempre: transferencia, 30 dias, sin IRPF, cuenta automatica, con IBAN y sin pie.
model AjustesFacturacion {
  id               String   @id @default(cuid())
  companyId        String   @unique
  /// TRANSFERENCIA | GIRO | CONTADO
  formaPago        String   @default("TRANSFERENCIA")
  diasVencimiento  Int      @default(30)
  /// IRPF habitual de las lineas (0, 1, 2, 7, 15 o 19). Siempre 0 fuera de Espana.
  irpfDefecto      Decimal  @default(0) @db.Decimal(5, 2)
  /// Cuenta bancaria que sale en la factura; null = la primera activa en la moneda de la factura.
  cuentaBancariaId String?
  mostrarIban      Boolean  @default(true)
  /// Texto legal al pie de la factura (maximo 500 caracteres).
  textoPie         String?  @db.Text
  /// La empresa repercute el IEEPNR en sus facturas.
  ieepnrRepercute   Boolean  @default(false)
  /// Tipo del IEEPNR en EUR por kg (Ley 7/2022: 0,45).
  ieepnrPorKg       Decimal  @default(0.45) @db.Decimal(8, 4)
  /// Cuenta del IEEPNR si la empresa fuera contribuyente; null = la de ingresos de la linea.
  ieepnrCuenta      String?  @db.VarChar(15)
  /// Cuenta de ingresos del cargo de palets (plantilla B, p. ej. 704); null = la de ventas.
  cuentaPalets      String?  @db.VarChar(15)
  updatedAt        DateTime @updatedAt
  updatedBy        String?
}

/// Imagenes de la plantilla B de factura: el logo de la marca (MARCA) y el sello
/// de la empresa (SELLO). PNG o JPG de 1 MB como mucho, una de cada por empresa.
/// Aparte de LegalConfig para no leer los bytes en cada consulta de la empresa.
model ImagenFactura {
  id        String   @id @default(cuid())
  companyId String
  /// MARCA | SELLO
  tipo      String   @db.VarChar(10)
  datos     Bytes    @db.MediumBlob
  mime      String   @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, tipo])
}

/// Ajustes fiscales que cambian el calendario de modelos (solo empresas
/// espanolas). Gran empresa obliga a SII; SII o REDEME obligan a IVA mensual.
model AjustesFiscales {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  /// TRIMESTRAL | MENSUAL
  periodicidadIva     String   @default("TRIMESTRAL")
  redeme              Boolean  @default(false)
  sii                 Boolean  @default(false)
  granEmpresa         Boolean  @default(false)
  /// Todavia no se aplican en los asientos ni en el 303: el PUT solo acepta su valor por defecto.
  recargoEquivalencia Boolean  @default(false)
  criterioCaja        Boolean  @default(false)
  prorrata            Decimal? @db.Decimal(5, 2)
  updatedAt           DateTime @updatedAt
  updatedBy           String?
  /// Primer dia (AAAA-MM-DD) en que la empresa lleva sus impuestos con la app.
  /// Los periodos que acaban antes no se crean ni cuentan como pendientes (los
  /// presento la gestoria). null = sin limite.
  inicioEnApp         String?  @db.VarChar(10)
}

/// Regimen fiscal por fecha de efecto (spec arranque-2027, B.7): periodicidad
/// del IVA, REDEME, SII y gran empresa desde `desde`. El calendario de cada
/// periodo usa el regimen vigente al empezar ese periodo (los anuales, el del
/// 1 de enero). Antes se deducia de AjustesFiscales.updatedAt, y guardar en
/// 2027 cambiaba el calendario de 2026. Nunca se borra una fila salvo las de
/// fecha posterior que un cambio nuevo deja sin efecto.
model AjustesFiscalesVigencia {
  id              String   @id @default(cuid())
  companyId       String
  /// Fecha de efecto (AAAA-MM-DD): primer dia al que se aplica.
  desde           String   @db.VarChar(10)
  /// TRIMESTRAL | MENSUAL
  periodicidadIva String   @db.VarChar(10)
  redeme          Boolean
  sii             Boolean
  granEmpresa     Boolean
  creadoEn        DateTime @default(now())
  creadoPor       String?

  @@unique([companyId, desde])
}

/// Ejercicio contable de una empresa.
model FiscalYear {
  id                      String                @id @default(cuid())
  companyId               String
  label                   String // ej. "2026"
  fechaInicio             String // YYYY-MM-DD
  fechaFin                String // YYYY-MM-DD
  estado                  String                @default("OPEN") // OPEN | CLOSED
  closingDate             String? // YYYY-MM-DD (se fija al cerrar)
  legalizationDeadline    String? // cierre + 4 meses
  accountsDepositDeadline String? // cierre + 7 meses
  asientosBloqueados      Boolean               @default(false)
  /// APP = la contabilidad de este año esta en la app; EXTERNA = la llevo la gestoria
  /// en su programa y en la app es solo de lectura (Traer la contabilidad de 2026).
  llevanza                String                @default("APP") @db.VarChar(10)
  /// Notas de la memoria que no salen de la contabilidad (plantilla media, partes
  /// vinculadas, hechos posteriores...). Ver services/memoria.service.ts.
  memoriaNotas            Json?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  books                   LegalBook[]
  packages                LegalizationPackage[]
  annualAccounts          AnnualAccounts[]

  @@unique([companyId, label])
  @@index([companyId])
}

/// Libro contable o societario generado (PDF/A) para un ejercicio.
model LegalBook {
  id           String     @id @default(cuid())
  companyId    String
  fiscalYearId String
  type         String // DIARIO | INVENTARIOS_CUENTAS_ANUALES | ACTAS | SOCIOS | CONTRATOS
  filePath     String
  format       String     @default("PDF/A")
  hash         String // SHA-256 del PDF
  status       String     @default("GENERATED") // PENDING | GENERATED | PACKAGE_READY | FILED | ACCEPTED | REJECTED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([fiscalYearId])
}

/// Expediente de legalización (ZIP de libros) presentado al Registro Mercantil.
model LegalizationPackage {
  id                  String     @id @default(cuid())
  companyId           String
  fiscalYearId        String
  zipPath             String
  hash                String // SHA-256 del ZIP
  size                Int        @default(0)
  status              String     @default("CREATED") // CREATED | FILED | ACCEPTED | REJECTED
  version             Int        @default(1) // Versión del expediente (1, 2, 3, etc.)
  expiresAt           DateTime? // Fecha de caducidad de esta versión
  isLatestVersion     Boolean    @default(true) // ¿Es la versión más reciente?
  filedAt             String?
  registryOffice      String?
  registryEntryNumber String?
  csv                 String? // CSV del justificante de presentación
  diligencePath       String? // PDF de la diligencia emitida por el Registro
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  fiscalYear          FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([fiscalYearId])
  @@index([companyId, isLatestVersion])
  @@index([companyId, expiresAt])
}

/// Depósito de cuentas anuales (balance, PyG, memoria) en el Registro Mercantil.
model AnnualAccounts {
  id                  String     @id @default(cuid())
  companyId           String
  fiscalYearId        String
  modelo              String     @default("PYME") // NORMAL | ABREVIADO | PYME
  filePath            String // PDF de la memoria
  dataJson            Json? // Balance + PyG + memoria en formato interno
  format              String     @default("PDF+JSON")
  hash                String
  status              String     @default("DRAFT") // DRAFT | READY | FILED | APROBADO | DEFECTOS | RECHAZADO
  version             Int        @default(1) // Versión de las cuentas (1, 2, 3, etc.)
  expiresAt           DateTime? // Fecha de caducidad de esta versión
  isLatestVersion     Boolean    @default(true) // ¿Es la versión más reciente?
  filedAt             String?
  registryEntryNumber String?
  csv                 String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  fiscalYear          FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([fiscalYearId])
  @@index([companyId, isLatestVersion])
  @@index([companyId, expiresAt])
}

/// Movimientos contables (ingresos/gastos)
model Movement {
  id                String   @id @default(cuid())
  companyId         String
  type              String // "income" | "expense"
  amount            Decimal  @db.Decimal(14, 2)
  category          String
  description       String
  date              DateTime
  referenceDocument String?
  fiscalYear        Int
  status            String   @default("draft") // "draft" | "approved" | "reconciled"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation("movements", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([date])
  @@index([type])
}

/// ============================================================================
/// OCR SESSIONS Y DOCUMENTOS (Lector OCR mejorado)
/// ============================================================================

/// Sesión de procesamiento OCR (subida de archivo → extracción de datos)
model OCRSession {
  id                    String        @id @default(cuid())
  companyId             String
  userId                String? // Usuario que inició la sesión
  originalFileName      String
  originalFilePath      String
  originalFileSize      Int
  originalMimeType      String
  language              String        @default("es") // Idioma detectado/especificado
  invoiceType           String        @default("expense") // "income" | "expense"
  source                String        @default("manual") // "manual" | "email" | "api"
  /// Estado: PENDING | PROCESSING | COMPLETED | FAILED
  status                String        @default("PENDING")
  ilovepdfTaskId        String? // ID de tarea en iLovePDF (si se usa)
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  processingTimeSeconds Int?
  /// Ruta al PDF procesado por OCR
  ocrPdfPath            String?
  ocrPdfSize            Int?
  /// Texto completo extraído por OCR
  ocrTextExtracted      String?       @db.Text
  /// Número de páginas procesadas
  ocrPageCount          Int?
  /// Número de caracteres extraídos
  ocrCharCount          Int?
  /// Código de error (si status=FAILED)
  errorCode             String?
  /// Mensaje de error (si status=FAILED)
  errorMessage          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  /// Relación con documentos extraídos de esta sesión
  documents             OCRDocument[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([userId])
}

/// Documento OCR extraído de una sesión (datos estructurados: números, importes, etc.)
model OCRDocument {
  id                   String   @id @default(cuid())
  sessionId            String
  companyId            String
  /// Datos extraídos (JSON con cliente, fecha, número, base, iva, líneas, etc.)
  extractedData        Json?
  /// ID de la factura de ingreso vinculada (tras verificación)
  linkedInvoiceId      String?
  /// ID del documento del lector de ingresos vinculado
  linkedReaderDocument String?
  /// Confianza de la extracción OCR (0-100)
  confidenceScore      Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  session OCRSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([companyId])
  @@index([linkedInvoiceId])
}

/// ============================================================================
/// PROVEEDORES: CONTACTOS, CUENTAS BANCARIAS, AUDITORÍA
/// ============================================================================

/// Contacto múltiple de un proveedor (personas de contacto)
model SupplierContact {
  id            String   @id @default(cuid())
  supplierId    String
  nombre        String
  apellido      String?
  email         String?
  telefono      String?
  rol           String   @default("general") // "general", "facturación", "técnico", etc.
  esPrincipal   Boolean  @default(false)
  observaciones String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([esPrincipal])
}

/// Cuenta bancaria de un proveedor (IBAN, BIC, datos de pago)
model SupplierBankAccount {
  id                  String   @id @default(cuid())
  supplierId          String
  iban                String
  bic                 String?
  banco               String?
  alias               String   @default("Cuenta principal")
  formaPagoPorDefecto String   @default("transferencia") // "transferencia", "cheque", "efectivo"
  esPrincipal         Boolean  @default(false)
  observaciones       String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, iban])
  @@index([supplierId])
  @@index([esPrincipal])
}

/// Auditoría de cambios en proveedores (log append-only)
model SupplierAudit {
  id            String   @id @default(cuid())
  supplierId    String
  usuarioEmail  String?
  tipoAccion    String // "create" | "update" | "delete"
  campo         String? // Campo modificado (si es update)
  valorAnterior String? // Valor anterior (JSON serializado)
  valorNuevo    String? // Valor nuevo (JSON serializado)
  descripcion   String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([supplierId])
  @@index([tipoAccion])
  @@index([createdAt])
}

/// Archivo de documento contable (facturas, comprobantes, etc.)
model DocumentoArchivo {
  id               String   @id @default(cuid())
  companyId        String
  /// "ingreso" | "gasto" | "nomina" | "seguros_sociales" (estos dos, solo con nominas:read)
  tipo             String
  numeroFactura    String?
  emisor           String?
  receptor         String?
  nifCif           String?
  fecha            String // YYYY-MM-DD
  mes              Int
  trimestre        Int
  anio             Int
  base             Decimal? @db.Decimal(14, 2)
  iva              Decimal? @db.Decimal(14, 2)
  retencion        Decimal? @db.Decimal(14, 2)
  total            Decimal? @db.Decimal(14, 2)
  /// Moneda de la factura archivada. base, iva y total van en moneda de cuenta.
  moneda           String   @default("EUR") @db.VarChar(3)
  /// Total en la moneda de la factura (si es distinta de la de cuenta).
  totalDivisa      Decimal? @db.Decimal(14, 2)
  tipoCambio       Decimal? @db.Decimal(18, 8)
  archivoNombre    String
  archivoTipo      String // MIME type
  archivoTamanio   Int
  archivoPath      String // Ruta o URL en storage
  archivoHash      String // SHA-256
  readerDocumentId String? // FK a IncomeReaderDocument
  incomeInvoiceId  String? // FK a IncomeInvoice
  expenseInvoiceId String? // FK a ExpenseInvoice (factura de gasto archivada)
  /// Nomina a la que corresponde el PDF (tipo "nomina"; null si es el PDF de todo el mes).
  nominaId         String?
  origen           String? // "manual" | "email" | "api"
  /// "activo" | "reemplazado" | "anulado"
  estado           String   @default("activo")
  confianza        Float? // Score de confianza (0-100)
  observaciones    String?  @db.Text
  uploadedBy       String? // UserId
  uploadedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, anio, mes])
  @@index([companyId, anio, trimestre])
  @@index([companyId, estado])
  @@index([numeroFactura])
  @@index([incomeInvoiceId])
  @@index([expenseInvoiceId])
  @@index([fecha])
}

/// Cache global de los tipos de referencia del BCE (unidades de `moneda` por
/// 1 EUR), por fecha REAL de observacion. Sirve para no repetir llamadas y como
/// prueba del tipo aplicado a cada factura.
model TipoCambioBce {
  moneda         String   @db.VarChar(3)
  /// AAAA-MM-DD de la observacion del BCE
  fecha          String   @db.VarChar(10)
  unidadesPorEur Decimal  @db.Decimal(18, 8)
  /// ECB_API | FRANKFURTER_ECB
  origen         String   @default("ECB_API") @db.VarChar(20)
  createdAt      DateTime @default(now())

  @@id([moneda, fecha])
}

/// Lectura de una factura con el lector (Azure, Claude o XML), desde que se sube hasta que se registra o se descarta.
/// Guarda el resultado NORMALIZADO y las validaciones; nunca la respuesta bruta de Azure ni la de Claude.
model LecturaDocumento {
  id                     String    @id @default(cuid())
  companyId              String
  userId                 String?
  /// VENTA | GASTO
  lector                 String    @db.VarChar(10)
  /// LEYENDO | LISTA | ERROR | CONFIRMADA | DESCARTADA
  estado                 String    @default("LEYENDO") @db.VarChar(12)
  /// AZURE | AZURE_CLAUDE | CLAUDE | FACTURAE (null mientras lee)
  origen                 String?   @db.VarChar(14)
  /// Por que se leyo con Claude en lugar de Azure (AZURE_NO_CONFIGURADO, AZURE_CUOTA...). null si leyo Azure.
  motivoRespaldo         String?   @db.VarChar(40)
  archivoNombre          String    @db.VarChar(255)
  archivoTipo            String    @db.VarChar(100)
  archivoTamanio         Int
  /// SHA-256 del archivo, en hexadecimal: detecta el mismo archivo subido dos veces
  archivoHash            String    @db.Char(64)
  /// Referencia en Blob (privado). null cuando se borra el archivo.
  archivoRef             String?   @db.Text
  paginasArchivo         Int?
  paginasLeidas          Int?
  /// resultId de Azure (UUID). Nunca la URL de Operation-Location.
  azureResultId          String?   @db.VarChar(64)
  azureProximaConsulta   DateTime?
  /// Consultas hechas a Azure; tambien sirve de version para el bloqueo optimista
  azureConsultas         Int       @default(0)
  iniciadaEn             DateTime  @default(now())
  terminadaEn            DateTime?
  /// Confianza de la lectura de 0 a 1; null si el lector no la da
  confianza              Float?
  /// ok | revisar | error
  estadoValidacion       String?   @db.VarChar(8)
  /// SIN_QR | COINCIDE | NO_COINCIDE | ILEGIBLE | AJENO (null si no se leyo el QR)
  qrEstado               String?   @db.VarChar(12)
  /// LecturaNormalizada + estado por campo. Se vacia al purgar.
  resultado              Json?
  /// [{ codigo, nivel, campos, mensaje }]
  validaciones           Json?
  /// Textos para el usuario (string[])
  avisos                 Json?
  errorCodigo            String?   @db.VarChar(40)
  /// El usuario marco "He revisado los datos marcados"
  revisada               Boolean   @default(false)
  confirmadaPor          String?
  confirmadaEn           DateTime?
  expenseInvoiceId       String?
  incomeInvoiceId        String?
  incomeReaderDocumentId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([companyId, estado])
  @@index([companyId, archivoHash])
  @@index([expenseInvoiceId])
  @@index([incomeInvoiceId])
}

/// VERI*FACTU: configuracion y activacion por empresa (spec verifactu, 2.1).
/// Version minima de la fase F0: solo lo que lee la red de seguridad. El resto
/// de campos (obligado, instalacion, certificado...) llega en F1 como columnas
/// nuevas. Sin fila = VERI*FACTU no activo.
model VerifactuConfig {
  id              String    @id @default(cuid())
  companyId       String    @unique
  /// DESACTIVADO | PRUEBAS | ACTIVO
  estado          String    @default("DESACTIVADO") @db.VarChar(12)
  /// PRUEBAS | PRODUCCION
  entorno         String    @default("PRUEBAS") @db.VarChar(12)
  /// Instante desde el que se generan registros (se puede programar a futuro).
  activaDesde     DateTime?
  activadaPor     String?
  activadaEn      DateTime?
  /// SII | FORAL | null. Si esta informado, VERI*FACTU no aplica y la red de seguridad no bloquea.
  motivoExclusion String?   @db.VarChar(10)
  updatedAt       DateTime  @updatedAt
  updatedBy       String?
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

/// Ajustes de toda la plataforma (no de una empresa), por clave (spec verifactu, 2.7).
/// 'verifactu.redSeguridad' -> { activa, motivo?, referenciaBoe? }. Sin fila, la red esta activa.
model AjustePlataforma {
  clave       String   @id @db.VarChar(64)
  valor       Json
  cambiadoPor String?
  cambiadoEn  DateTime @updatedAt
}

/// Una carga de la contabilidad del ano anterior (Traer la contabilidad de 2026):
/// los ficheros de la gestoria y lo que se hizo con ellos.
model CargaArranque {
  id            String    @id @default(cuid())
  companyId     String
  /// Ejercicio de destino: 2027.
  ejercicio     Int
  version       Int
  /// PROVISIONAL | DEFINITIVA
  tipo          String    @db.VarChar(12)
  /// BORRADOR | APLICANDO | CONFIRMADA | SUSTITUIDA | DESHECHA
  estado        String    @db.VarChar(12)
  /// [{ nombre, sha256, tamano, clave, hojas: [{ hoja, tipo, programa, confianza }] }]
  ficheros      Json
  /// Decisiones de la persona: tipo y mapeo por hoja, exclusiones, datos a mano.
  ajustes       Json?
  /// SHA-256 del resumen analizado: si cambia al confirmar, 409.
  huella        String?   @db.VarChar(64)
  /// [{ fase, estado, inicio, fin, cursor, error }]
  fases         Json?
  /// Ids creados por fase (cuentas, fichas, asientos, partidas, activos).
  creado        Json?
  /// Valores previos para deshacer (nombres, longitud, enlaces, llevanza, ids retirados...).
  anterior      Json?
  /// Cifras, comprobaciones, avisos aceptados y datos fiscales.
  resumen       Json?
  createdBy     String
  confirmadaPor String?
  confirmadaEn  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([companyId, ejercicio, version])
  @@index([companyId, ejercicio, estado])
}

/// Factura de 2026 pendiente de cobro o pago a 31-12. No genera asiento ni IVA:
/// su saldo ya esta en la apertura.
model PartidaPendiente {
  id               String   @id @default(cuid())
  companyId        String
  cargaId          String
  /// COBRO | PAGO
  tipo             String   @db.VarChar(5)
  subcuenta        String   @db.VarChar(15)
  customerId       String?
  supplierId       String?
  /// Si la factura se emitio o registro en la app en 2026.
  incomeInvoiceId  String?
  expenseInvoiceId String?
  numeroDocumento  String   @db.VarChar(60)
  fechaDocumento   String?  @db.VarChar(10)
  fechaVencimiento String?  @db.VarChar(10)
  importeOriginal  Decimal? @db.Decimal(14, 2)
  /// A 31-12; negativo = anticipo o abono.
  importePendiente Decimal  @db.Decimal(14, 2)
  moneda           String   @default("EUR") @db.VarChar(3)
  /// Partida «Saldo sin detalle a 31-12-2026».
  sinDetalle       Boolean  @default(false)
  /// PENDIENTE | PARCIAL | LIQUIDADA | ANULADA
  estado           String   @default("PENDIENTE") @db.VarChar(10)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, cargaId, tipo, subcuenta, numeroDocumento])
  @@index([companyId, estado])
  @@index([companyId, subcuenta])
}

/// Elemento de inmovilizado con amortizacion lineal.
model ActivoFijo {
  id                      String                 @id @default(cuid())
  companyId               String
  cargaId                 String?
  descripcion             String                 @db.VarChar(191)
  /// 2xx
  subcuentaBien           String                 @db.VarChar(15)
  /// 28x
  subcuentaAmortAcum      String                 @db.VarChar(15)
  /// 68x
  subcuentaDotacion       String                 @db.VarChar(15)
  fechaAlta               String                 @db.VarChar(10)
  fechaInicioAmortizacion String                 @db.VarChar(10)
  coste                   Decimal                @db.Decimal(14, 2)
  valorResidual           Decimal                @default(0) @db.Decimal(14, 2)
  amortAcumuladaInicial   Decimal                @default(0) @db.Decimal(14, 2)
  /// 2026-12-31 en los traidos.
  fechaAmortAcumulada     String?                @db.VarChar(10)
  /// % anual
  coeficiente             Decimal                @db.Decimal(6, 3)
  metodo                  String                 @default("LINEAL") @db.VarChar(10)
  fechaBaja               String?                @db.VarChar(10)
  activo                  Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  dotaciones              DotacionAmortizacion[]

  @@index([companyId])
}

/// Dotacion de un activo en un mes: impide amortizar dos veces el mismo mes.
model DotacionAmortizacion {
  id             String     @id @default(cuid())
  companyId      String
  activoFijoId   String
  /// AAAA-MM
  periodo        String     @db.VarChar(7)
  importe        Decimal    @db.Decimal(14, 2)
  journalEntryId String
  anulada        Boolean    @default(false)
  createdAt      DateTime   @default(now())
  activoFijo     ActivoFijo @relation(fields: [activoFijoId], references: [id])

  @@unique([activoFijoId, periodo])
  @@index([companyId, periodo])
}
