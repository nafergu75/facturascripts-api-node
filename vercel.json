{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "express",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/cron/carmen-purga",
      "schedule": "30 3 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
