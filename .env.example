# Puerto del servidor HTTP
PORT=3000

# Entorno: development | production | test
NODE_ENV=development
# Atajo SOLO para desarrollo local: acepta tokens sin firma y cualquier empresa.
# Requiere NODE_ENV=development. Nunca lo definas en un despliegue.
# ALLOW_INSECURE_DEV_AUTH=1

# BD propia (MySQL via Prisma). En dev reutilizamos el MySQL de XAMPP.
DATABASE_URL=mysql://root@127.0.0.1:3306/fs_api_node

# Clave de cifrado AES-256-GCM para los secretos en reposo (FS_API_KEY por empresa).
# 32 bytes en hexadecimal (64 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=pon_aqui_64_caracteres_hex

# Secreto para firmar los JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# FacturaScripts por defecto (solo lo usa el seed de la empresa demo)
FS_API_URL=http://localhost:8000/api/3
FS_API_KEY=tu-api-key-de-facturascripts

# Origenes permitidos por CORS (lista separada por comas). En produccion acota a
# los dominios reales del frontend. Por defecto: puertos de los dos frontends
# Vite (5173/4173 y 5174/4174) + la API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:5174,http://localhost:4174,http://localhost:3000,http://localhost:4175

# Clave de Claude (Anthropic) para el lector de facturas y la capa de IA de
# Carmen. OPCIONAL: sin ella Carmen responde con los datos de la app y sus
# fichas, sin IA. Consiguela en https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# --- Carmen ---
# La IA de Carmen esta apagada mientras esto no valga true. Ademas, cada empresa
# tiene que activarla en sus ajustes (solo un administrador).
# CARMEN_LLM_ACTIVO=false
# CARMEN_MODELO=claude-haiku-4-5-20251001
# Tope de gasto de la IA en el mes, para todas las empresas (euros).
# CARMEN_TOPE_MENSUAL_EUR=5
# Preguntas a la IA por dia: por empresa y por usuario.
# CARMEN_TOPE_EMPRESA_DIA=100
# CARMEN_TOPE_USUARIO_DIA=15
# Mensajes a Carmen por usuario y dia (freno contra abusos).
# CARMEN_MENSAJES_USUARIO_DIA=300
# Tokens de salida por respuesta de la IA (500 como maximo).
# CARMEN_MAX_TOKENS_SALIDA=500
