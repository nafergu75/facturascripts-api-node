# Frontend Chakra — configuración por entorno

# DEV (local): BFF en localhost:3000
# No necesita .env (usa default)

# STAGING: BFF en Vercel staging
VITE_API_BASE_URL=https://conta-api-staging.vercel.app/api

# PROD: BFF en Vercel prod
# VITE_API_BASE_URL=https://conta-api-nafergu75s-projects.vercel.app/api

# Cómo usar:
# DEV: npm run dev:chakra (sin .env, usa localhost)
# STAGING: cp .env.example .env.local && npm run build:chakra && vercel
# PROD: editar esta variable y desplegar
